# Copy to backend/.env and fill in. Nothing here is a real secret. See docs/11-auth.md for the Google sign-in setup.

# The defaults match docker-compose.yml, so these three can stay as they are for local development.
DATABASE_URL=postgresql+asyncpg://lexi_user:secure_password@localhost:5432/jurion_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_graph_password
REDIS_URL=redis://localhost:6379/0

# Encrypts the API keys users save in the app. Generate:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Google sign-in (an OAuth client ID from the Google Cloud console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ALLOWED_DOMAIN=yourcompany.com    # only this Google Workspace domain may sign in; leave out to allow any Google account

# Optional server-side fallbacks. Users normally save their own keys in the app (key icon in the top bar).
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ASK_MODEL=gpt-4o-mini             # grades, rewrites and answers on the Ask tab
